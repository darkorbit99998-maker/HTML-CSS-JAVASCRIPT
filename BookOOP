  new Book("L'Alchimiste", "Paulo Coelho", "Un voyage initiatique à la recherche d'un trésor.", 208)
];

// prüfen de la méthode readBook
database[0].readBook(50);  // Avance à la page 50
database[0].readBook(184); // Termine le livre (read passe à true)
